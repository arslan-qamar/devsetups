# -*- mode: ruby -*-
# vi: set ft=ruby :

require 'shellwords'
load File.expand_path("../../vagrant-common/shared_folder.rb", __dir__)

def interface_up?(name)
  operstate_path = "/sys/class/net/#{name}/operstate"
  File.exist?(operstate_path) && File.read(operstate_path).strip == 'up'
end

def positive_integer_env(name)
  raw_value = ENV[name].to_s.strip
  return if raw_value.empty?

  parsed_value = Integer(raw_value, 10)
  raise ArgumentError, "#{name} must be greater than zero" if parsed_value <= 0

  parsed_value
rescue ArgumentError
  raise ArgumentError, "#{name} must be a positive integer"
end

def linux_bridge?(name)
  File.directory?("/sys/class/net/#{name}/bridge")
end

def default_route_interface
  route = `ip route get 1.1.1.1 2>/dev/null`.strip
  route[/\bdev\s+(\S+)/, 1].to_s
end

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu-dev"
  # Set VM name to the folder name where `vagrant up` is run
  config.vm.define 'vm'
  vagrant_base_dir = __dir__
  vm_name = File.basename(Dir.pwd)
  machine_virtual_size_gb = positive_integer_env('VAGRANT_VM_DISK_SIZE_GB')
  resize_existing_disk_script = File.join(vagrant_base_dir, 'resize_libvirt_primary_disk.sh')
  resize_guest_root_fs_script = File.join(vagrant_base_dir, 'resize_guest_root_fs.sh')
  configure_spice_socket_script = File.join(vagrant_base_dir, 'configure_spice_socket.sh')
  remote_viewer_recent_script = File.join(vagrant_base_dir, 'register_remote_viewer.py')
  config.vm.hostname = "#{vm_name}-vm"
  config.ssh.username = "ubuntu"  
  config.ssh.private_key_path = [ENV.fetch('VAGRANT_CUSTOM_KEY_PATH')] 
  config.ssh.insert_key = false

  DevSetupsSharedFolder.configure_linux(config)

  # Prefer an explicit override, then br0, then any other active host bridge.
  # If no bridge exists, fall back to the active uplink interface and let
  # libvirt attach the guest in direct bridge mode. The provider's management
  # network remains available if no public interface can be selected.
  public_network_options = begin
    override = ENV['VAGRANT_BRIDGE'].to_s.strip
    chosen_interface = nil

    if !override.empty? && File.directory?("/sys/class/net/#{override}") && interface_up?(override)
      chosen_interface = override
    else
      candidate_bridges = Dir.glob('/sys/class/net/*/bridge').map { |path| File.basename(File.dirname(path)) }
      active_bridges = candidate_bridges.select do |name|
        interface_up?(name)
      end.reject do |name|
        name =~ /^(virbr|docker)/
      end

      chosen_interface = active_bridges.find { |name| name == 'br0' } ||
        active_bridges.first

      if chosen_interface.nil?
        uplink = default_route_interface
        if !uplink.empty? && interface_up?(uplink) && uplink !~ /^(virbr|docker|vnet|tap)/
          chosen_interface = uplink
        end
      end
    end

    if chosen_interface
      if linux_bridge?(chosen_interface)
        {
          type: 'public_network',
          options: {
            libvirt__dev: chosen_interface,
            libvirt__mode: 'bridge',
            libvirt__type: 'bridge'
          }
        }
      else
        {
          type: 'public_network',
          options: {
            dev: chosen_interface,
            libvirt__dev: chosen_interface,
            libvirt__mode: 'bridge',
            libvirt__type: 'direct'
          }
        }
      end
    end
  end

    if machine_virtual_size_gb
      resize_existing_disk_command = Shellwords.join([
        '/bin/bash',
        resize_existing_disk_script,
        Dir.pwd,
        machine_virtual_size_gb.to_s
      ])

      [:up, :reload, :provision].each do |action|
        config.trigger.before action do |trigger|
          trigger.info = "Growing existing libvirt disk to #{machine_virtual_size_gb}G when needed"
          trigger.run = {
            inline: "/bin/bash -lc #{Shellwords.escape(resize_existing_disk_command)}"
          }
        end
      end
    end

    [:up, :reload].each do |action|
      config.trigger.after action do |trigger|
        trigger.info = "Configuring SPICE socket and two display heads for #{vm_name}_vm"
        trigger.run = {
          inline: Shellwords.join(['/bin/bash', configure_spice_socket_script, "#{vm_name}_vm"])
        }
      end
    end

    config.trigger.after :destroy do |trigger|
      trigger.info = "Removing Remote Viewer connection for #{vm_name}_vm"
      trigger.run = {
        inline: Shellwords.join(['/usr/bin/python3', remote_viewer_recent_script, '--remove', "#{vm_name}_vm"])
      }
    end

  if public_network_options
    config.vm.network public_network_options[:type], **public_network_options[:options]
  end
  
  config.vm.provider "libvirt" do |libvirt|
    libvirt.cpus = 6
    libvirt.memory = 16384
    libvirt.management_network_autostart = true
    libvirt.machine_virtual_size = machine_virtual_size_gb if machine_virtual_size_gb
    libvirt.graphics_type = "spice"
    libvirt.video_type = "virtio"
    libvirt.video_vram = 4096
    libvirt.sound_type = "ich9"
    libvirt.channel type: 'spicevmc', target_name: 'com.redhat.spice.0', target_type: 'virtio'
  end

  # Copy host timezone file to a temporary location in the VM
  config.vm.provision "file", source: "/etc/timezone", destination: "/tmp/host-timezone"

  # Ensure the timezone is set correctly
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    echo "Moving timezone file to /etc/timezone..."
    sudo cp /tmp/host-timezone /etc/timezone
    echo "Updating timezone using dpkg-reconfigure..."
    sudo ln -sf /usr/share/zoneinfo/$(cat /etc/timezone) /etc/localtime
    sudo dpkg-reconfigure -f noninteractive tzdata
  SHELL

  if machine_virtual_size_gb
    config.vm.provision "shell", name: "expand_root_filesystem", run: "always", privileged: true,
      path: resize_guest_root_fs_script
  end

end

# -*- mode: ruby -*-
# vi: set ft=ruby :

require_relative "../../vagrant-common/windows_nvram"
load File.expand_path("../../vagrant-common/shared_folder.rb", __dir__)

nvram_path = File.expand_path(ENV.fetch(
  "WIN11_NVRAM_PATH",
  File.expand_path(".vagrant/windows11-home-dev_VARS.fd", __dir__)
))
WindowsNvram.prepare(nvram_path)

Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("WIN11_BOX_NAME", "windows11-home-dev")
  config.vm.hostname = ENV.fetch("WIN11_HOSTNAME", "windows11-dev")
  config.vm.boot_timeout = 1800
  config.winssh.insert_key = false
  config.winssh.connect_timeout = 600

  # The base box supplies the Windows guest, WinSSH, UEFI, TPM, disk, network,
  # and graphics settings. Disable the default share because Windows does not
  # include the rsync tooling used by vagrant-libvirt.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  DevSetupsSharedFolder.configure_windows(config)

  config.vm.provider "libvirt" do |libvirt|
    libvirt.default_prefix = "windows11"
    # Supplying NVRAM makes vagrant-libvirt use the OVMF image as pflash.
    # Without it, the provider incorrectly passes the 4 MB image as -bios.
    libvirt.loader = "/usr/share/OVMF/OVMF_CODE_4M.ms.fd"
    libvirt.nvram = nvram_path
  end
end

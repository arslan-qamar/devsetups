# -*- mode: ruby -*-

ENV['VAGRANT_CUSTOM_KEY_PATH'] ||= File.expand_path('../../ubuntu-autoinstall/vagrant_custom_key', __dir__)
load File.expand_path('../../ubuntu-autoinstall/vagrant-base/VagrantBaseFile', __dir__)
require_relative '../project_vm'

Vagrant.configure('2') do |config|
  ProjectVM.provision(config,
    repository: 'gaspeep',
    tools: %w[deps doppler helm argocd kubectl python docker githubcli zsh postgres postman cloudflare vscode dotnet microk8s go nodejs],
    git_signing: true)

  config.vm.provider 'libvirt' do |libvirt|
    libvirt.memory = 8192
    libvirt.usb_controller model: 'qemu-xhci'
    2.times { libvirt.redirdev type: 'spicevmc' }
  end
end
